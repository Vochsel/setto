# ───────────────────────────── Site ────────────────────────────────
# Public origin of the deployed app. Used as the metadataBase for absolute
# Open Graph / Twitter URLs. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────────────────────── Convex ──────────────────────────────
# Created automatically by `npx convex dev`. It writes CONVEX_DEPLOYMENT and
# prints your deployment URL — copy it into NEXT_PUBLIC_CONVEX_URL.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ──────────────────────────── WorkOS ───────────────────────────────
# From the WorkOS dashboard (https://dashboard.workos.com).
WORKOS_API_KEY=sk_...
WORKOS_CLIENT_ID=client_...
# 32+ char secret. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI configured in WorkOS. AuthKit 4.x reads the
# middleware redirect from the NEXT_PUBLIC_ copy, so set both.
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# ──────────────────── Remote MCP (Claude.ai / ChatGPT online) ──────────
# The web app hosts a remote MCP server at /api/mcp so Claude.ai and ChatGPT
# connectors can drive the product over HTTPS. Connectors authenticate via
# WorkOS AuthKit acting as an OAuth 2.0 server (the {slug}.authkit.app/oauth2/*
# endpoints). Tokens from that flow are signed with the same keys as the AuthKit
# SDK's tokens but carry iss = the AuthKit domain, so both the /api/mcp route and
# Convex validate against that issuer + its /oauth2/jwks.
#
# MCP_AUTHORIZATION_SERVER — your WorkOS AuthKit domain, e.g.
#   https://your-app.authkit.app. This is the OAuth authorization server that
#   connectors log in to; we advertise it from /.well-known/oauth-protected-
#   resource and pin token issuers to it. Set the SAME value in the Convex
#   deployment (`npx convex env set MCP_AUTHORIZATION_SERVER …`) so tool calls
#   the MCP server makes are accepted. Enable Dynamic Client Registration for
#   this environment in the WorkOS dashboard so connectors can self-register.
MCP_AUTHORIZATION_SERVER=https://your-app.authkit.app
# Optional: override the public URL of the MCP endpoint (defaults to the request
# origin + /api/mcp). Set this if the app sits behind a proxy that rewrites Host.
# MCP_RESOURCE_URL=https://app.example.com/api/mcp

# ──────────────────────── Campaign copywriter (OpenAI) ─────────────────
# The campaign copy writer is a streaming AI-SDK chat that runs in the Next.js
# route app/api/campaigns/[id]/copy-chat — so it needs the OpenAI key in the
# FRONTEND env (not just the Convex deployment). Set it here too.
OPENAI_API_KEY=sk-...
# Optional: pin the OpenAI text model used for copy (defaults to the registry,
# convex/lib/textModels.ts — currently gpt-5).
# OPENAI_TEXT_MODEL=gpt-5

# ─── Set these in the CONVEX deployment env (npx convex env set NAME val) ───
# WORKOS_CLIENT_ID     — your application client id (same as above).
# WORKOS_JWT_CLIENT_ID — the environment client id WorkOS puts in the token
#                        `iss` (https://api.workos.com/user_management/<id>).
#                        Often differs from the app client id; read it from a
#                        token's `iss` claim. Used to validate JWTs in Convex.
# GOOGLE_MAPS_API_KEY  — Google key with Street View Static API enabled.
# --- image generation providers (set the ones you want to use) ---
# FAL_KEY              — fal.ai key (FLUX, Imagen, Ideogram, Recraft, nano-banana).
# OPENAI_API_KEY       — OpenAI key for GPT Image models AND campaign ad-copy (GPT).
# OPENAI_TEXT_MODEL    — (optional) override the chat model used for campaign
#                        copy (default "gpt-4o"), e.g. "gpt-4.1".
# GOOGLE_AI_API_KEY    — Google AI (Gemini) key for Nano Banana / Gemini 2.5 Flash Image.

# ──────────────────────── Google Maps (browser) ────────────────────
# Key with Maps JavaScript API + Places API enabled (restrict to your domain).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID for vector/styled maps + advanced markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ─────────────────── messaging agent (Telegram / iMessage) ───────────────────
# The agent lives in apps/web/agent and mounts on this deployment via withEve.
# See the README, "Messaging agent", for the full setup.

# --- Telegram (free, the default channel) ---
# Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Must match the secret_token you pass to setWebhook.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
# Optional; lets the bot recognise @mentions in groups.
TELEGRAM_BOT_USERNAME=
# Who may talk to the bot, comma-separated chat ids. UNSET MEANS NOBODY — a bot
# username is discoverable, so this is the real boundary. The first entry gets
# the daily suggestion.
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Sendblue (iMessage; optional, needs a paid line for outbound) ---

# Sendblue (https://sendblue.com) — API credentials from the dashboard.
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# The number the agent texts FROM. Required for agent-initiated messages (the
# daily suggestion); a dedicated line is a paid Sendblue plan.
SENDBLUE_FROM_NUMBER=+1...
# Who may talk to the agent, comma-separated E.164. UNSET MEANS NOBODY — this
# is the only thing standing between a wrong number and your catalogue. The
# first entry is who the daily suggestion is sent to.
SENDBLUE_ALLOWED_NUMBERS=+61...
# Optional but recommended: the secret you configure on the Sendblue webhook.
# When set, inbound requests must carry it or they're rejected.
SENDBLUE_WEBHOOK_SECRET=

# Shared secret between the agent and Convex (convex/agent.ts). Generate with
# `openssl rand -hex 32` and set the SAME value in the Convex deployment:
#   npx convex env set AGENT_SHARED_SECRET "<value>" --prod
AGENT_SHARED_SECRET=

# The agent answers with Sonnet 5 through the Vercel AI Gateway. On Vercel this
# is provisioned automatically (OIDC); locally, run `vercel env pull` or set:
# AI_GATEWAY_API_KEY=
